# Root .env — used ONLY by docker-compose.prod.yml (${VAR} interpolation).
# Copy to .env before `docker compose -f docker-compose.prod.yml up --build`.
# Per-service secrets live in each service's own .env (see their .env.example).

# Postgres (the compose postgres service + the backend's DATABASE_URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=            # REQUIRED — choose a strong password
POSTGRES_DB=focusflow

# Host ports (only these two services are published).
FRONTEND_PORT=8080
BACKEND_PORT=3003

# Frontend build args — PUBLIC (baked into the JS bundle). Never put a secret here.
# Empty API/SOCKET URL = same-origin: nginx proxies /api + /socket.io to the backend.
VITE_API_URL=
VITE_SOCKET_URL=
VITE_CLERK_PUBLISHABLE_KEY=   # REQUIRED — pk_live_... / pk_test_...
