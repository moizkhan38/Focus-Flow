# ── Slack ────────────────────────────────────────────────────────────────────
# PREFERRED: connect Slack from the app (Integrations page). Those credentials
# are encrypted per organization and the bot picks them up within ~60s, so the
# three values below are only a fallback for deployments configured by file.
#
# Precedence at runtime: stored Integrations credentials → these env vars.

# Slack bot token (xoxb-...)
SLACK_BOT_TOKEN=

# Slack signing secret — verifies requests genuinely come from Slack.
# If neither this nor a stored credential is available, the bot still starts but
# REFUSES all /slack/* requests with 503 (it never accepts unverified requests).
SLACK_SIGNING_SECRET=

# Google Gemini API key
GEMINI_API_KEY=
# Optional Gemini model override (default gemini-2.0-flash)
GEMINI_MODEL=

# Jira Cloud
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM

# Analyzer webhook (optional). Also settable from the Integrations page, which
# takes precedence over this value.
STANDUP_ANALYZER_URL=

# Express DB endpoint for saving standups.
# MUST include the /api/db/standups path. With a bare origin the POST 404s and
# every standup silently falls back to an unencrypted, org-less JSON file on disk.
EXPRESS_DB_URL=http://localhost:3003/api/db/standups

# Express origin, used to fetch stored Slack credentials. Derived from
# EXPRESS_DB_URL when unset — only set this if the two differ.
EXPRESS_BASE_URL=

# Shared internal-service key — must match Express. Gates /api/standup* (Express -> bot).
INTERNAL_API_KEY=

# Key for calling Express's /api/internal/* lane (decrypted Slack + Jira creds).
# Must match INTERNAL_CREDENTIALS_KEY on the backend. Keep it distinct from
# INTERNAL_API_KEY, which epic-generator also holds — that service should never
# be able to authenticate to the credential lane. Blank = falls back to
# INTERNAL_API_KEY.
INTERNAL_CREDENTIALS_KEY=

# Slack user -> Jira account map, for people whose Slack and Jira accounts use
# DIFFERENT email addresses. Without it the bot matches on the Slack profile
# email, then on a uniquely-matching display name; if neither lands, that person
# cannot move tickets (ownership is fail-closed by design).
# JSON, values may be a Jira email or an accountId:
#   STANDUP_JIRA_USER_MAP={"U01ABC2DEF":"me@work.com"}
# Find a Slack user id in Slack: profile -> ... -> Copy member ID.
# Check what the bot resolves: GET /test/whoami/<slackUserId> with X-Admin-Key.
STANDUP_JIRA_USER_MAP=

# Admin key — gates the /test/* routes. Blank = those routes return 404 (recommended).
ADMIN_API_KEY=

# Daily standup reminder time (24h). Default 09:30.
REMINDER_HOUR=9
REMINDER_MINUTE=30
# The wall clock the time above is read in — an IANA zone name. SET THIS ON THE
# DEPLOYED BOT: container hosts run in UTC, so without it a 09:30 reminder
# reaches a UTC+5 team at 14:30. Default: Asia/Karachi.
REMINDER_TIMEZONE=Asia/Karachi

# Override the daily schedule with a repeating interval, in minutes. Intended for
# demos and testing — nobody can wait until 09:30 tomorrow to check a fix. People
# who have already submitted are skipped, but this still DMs everyone who has not,
# on every run. Leave blank (or 0) for the daily schedule above.
REMINDER_INTERVAL_MINUTES=

# Server bind + dev flag
HOST=127.0.0.1
PORT=3000
FLASK_DEBUG=false

# Clerk org id this bot posts standups into (Phase 1 binding, decision D6)
STANDUP_ORG_ID=
