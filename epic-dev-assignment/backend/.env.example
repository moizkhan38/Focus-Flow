# Flask Service URL
FLASK_URL=http://localhost:5000
# Shared internal-service key (Express ↔ Flask ↔ standup-bot). Blank in local
# dev = no gating; set the SAME non-empty value in all three services in prod.
INTERNAL_API_KEY=

# Server Port
PORT=3003

# GitHub API (Optional - increases rate limit)
GITHUB_TOKEN=

# Jira Cloud
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_BOARD_ID=

# PostgreSQL — required, no fallback. App refuses to start if unset.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/focusflow
# Set to true for managed Postgres providers that require TLS (RDS, Supabase, Neon, ...)
DATABASE_SSL=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3003
