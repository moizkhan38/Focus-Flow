# Flask Service URL
FLASK_URL=http://localhost:5000
# Standup bot service URL (Express proxies /api/standup* to it)
FOCUS_FLOW_URL=http://localhost:3000
# Shared internal-service key (Express ↔ Flask ↔ standup-bot). Blank in local
# dev = no gating; set the SAME non-empty value in all three services in prod.
INTERNAL_API_KEY=
# REQUIRED for the internal lane. Pins it to ONE organization.
# /api/internal/* returns DECRYPTED Jira and Slack credentials, and the caller
# used to name its own tenant via X-Org-Id — so anyone holding the shared key
# could enumerate org ids and read every tenant's secrets. The lane now acts ONLY
# as the org named here; X-Org-Id may agree with it but can never widen it.
# Per D6 the bot serves one org: set this to the bot's STANDUP_ORG_ID.
# Blank = the internal lane is DISABLED (503) — fail closed, not open.
INTERNAL_ORG_ID=
# Separate key for /api/internal/* (the plaintext-credential lane). Strongly
# recommended: INTERNAL_API_KEY above is also held by epic-generator, which needs
# it only to VERIFY inbound calls — but with one symmetric secret, holding the
# verifier IS holding the caller credential, so a file read in that small Flask
# app was enough to pull decrypted tokens out of this backend. Set the same value
# here and in standup-bot/.env, and NOWHERE else. Blank = falls back to
# INTERNAL_API_KEY (logs a warning at boot).
INTERNAL_CREDENTIALS_KEY=

# Server Port
PORT=3003

# --- Hardening ---
# Set to 1 when behind a reverse proxy / load balancer (correct client IPs + rate limiting)
TRUST_PROXY=0
# Max JSON request body size
JSON_BODY_LIMIT=2mb
# Global API rate limit: requests per IP per 15 minutes
RATE_LIMIT_MAX=300
# Daily developer-roster refresh schedule (cron). Default 03:00.
DEV_REFRESH_CRON=0 3 * * *

# NOTE: Jira and GitHub credentials are NO LONGER configured here. Each client
# organization connects its own from the app (sidebar → Integrations); they are
# encrypted with CREDENTIALS_MASTER_KEY (below) and stored per org in Postgres.
# The old JIRA_DOMAIN / JIRA_EMAIL / JIRA_API_TOKEN / JIRA_BOARD_ID / GITHUB_TOKEN
# vars are dead — the backend never reads them (see PRODUCTION-PLAN.md, Phase 2).

# PostgreSQL — required, no fallback. App refuses to start if unset.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/focusflow
# Set to true for managed Postgres providers that require TLS (RDS, Supabase, Neon, ...)
DATABASE_SSL=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3003

# Clerk (accounts/orgs) — see PRODUCTION-PLAN.md Phase 1
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Per-org integrations (Phase 2) ---
# Master key that wraps each org's encrypted Jira/GitHub credentials
# (AES-256-GCM envelope). Base64-encoded 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up securely: losing this key makes every stored integration
# credential permanently unrecoverable (clients must reconnect).
CREDENTIALS_MASTER_KEY=
