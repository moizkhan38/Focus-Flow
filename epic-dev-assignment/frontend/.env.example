# Backend origin for the production build.
# Empty = same-origin (dev uses the Vite proxy; prod behind a reverse proxy that
# serves /api on the same host). Set to your API host on split hosting, e.g.
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# Socket.IO origin. Defaults to VITE_API_URL, or the page origin in production.
# Only set if your websocket endpoint differs from the API origin.
VITE_SOCKET_URL=

# NOTE: every VITE_-prefixed value is PUBLIC — it is baked into the client bundle.
# Never put secrets (tokens, keys, passwords) in this file.
