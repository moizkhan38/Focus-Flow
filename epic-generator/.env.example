# Google Gemini API Key — get yours from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional model override. Default gemini-2.0-flash (broadly available on new keys).
# 2.5-flash is gated for new keys; gemini-flash-latest is newest but can 503 under load.
GEMINI_MODEL=

# Server bind (production defaults: loopback only, debug OFF).
# FLASK_DEBUG=true enables the Werkzeug console — NEVER do this on a public host.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# CORS — only the Express gateway (and dev frontend) may call this internal service.
CORS_ORIGINS=http://localhost:3003,http://localhost:5173

# Shared internal-service key — must match Express. Blank in local dev = no gating.
INTERNAL_API_KEY=
